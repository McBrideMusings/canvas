{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Canvas",
  "version": "0.1.0",
  "identifier": "com.piercemakes.canvas",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Canvas",
        "url": "canvas://localhost/",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 23 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["canvas-post"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../target/release/canvas": "canvas"
    }
  }
}

{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "\"$HOME/.local/bin/canvas\" hook session-start", "timeout": 5 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "\"$HOME/.local/bin/canvas\" hook prompt", "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "\"$HOME/.local/bin/canvas\" hook session-end", "timeout": 5 }] }
    ]
  }
}
